text=[@#%0a# Sample configuration file for ISC dhcpd for Debian%0a#%0a# $Id: dhcpd.conf,v 1.1.1.1 2002/05/21 00:07:44 peloy Exp $%0a#%0a%0a# The ddns-updates-style parameter controls whether or not the server will%0a# attempt to do a DNS update when a lease is confirmed. We default to the%0a# behavior of the version 2 packages ('none', since DHCP v2 didn't%0a# have support for DDNS.)%0addns-update-style none;%0a%0a# option definitions common to all supported networks...%0aoption domain-name "example.org";%0aoption domain-name-servers ns1.example.org, ns2.example.org;%0a%0adefault-lease-time 600;%0amax-lease-time 7200;%0a%0a# If this DHCP server is the official DHCP server for the local%0a# network, the authoritative directive should be uncommented.%0a#authoritative;%0a%0aauthoritative;%0a%0asubnet 192.168.20.0 netmask 255.255.255.0 {%0a    range 192.168.20.20 192.168.20.250;%0a    option domain-name "ltspcasa";%0a    option domain-name-servers 192.168.20.1;%0a    option broadcast-address 192.168.20.255;%0a    option routers 192.168.20.1;%0a    next-server 192.168.20.1;%0a#    get-lease-hostnames true;%0a    option subnet-mask 255.255.255.0;%0a    option root-path "/opt/ltsp/i386";%0a    if substring( option vendor-class-identifier, 0, 9 ) = "PXEClient" {%0a        filename "/ltsp/i386/pxelinux.0";%0a    } else {%0a        filename "/ltsp/i386/nbi.img";%0a    }%0a}%0a%0a# Use this to send dhcp log messages to a different log file (you also%0a# have to hack syslog.conf to complete the redirection).%0alog-facility local7;%0a%0a# No service will be given on this subnet, but declaring it helps the %0a# DHCP server to understand the network topology.%0a%0a#subnet 10.152.187.0 netmask 255.255.255.0 {%0a#}%0a%0a# This is a very basic subnet declaration.%0a%0a#subnet 10.254.239.0 netmask 255.255.255.224 {%0a#  range 10.254.239.10 10.254.239.20;%0a#  option routers rtr-239-0-1.example.org, rtr-239-0-2.example.org;%0a#}%0a%0a# This declaration allows BOOTP clients to get dynamic addresses,%0a# which we don't really recommend.%0a%0a#subnet 10.254.239.32 netmask 255.255.255.224 {%0a#  range dynamic-bootp 10.254.239.40 10.254.239.60;%0a#  option broadcast-address 10.254.239.31;%0a#  option routers rtr-239-32-1.example.org;%0a#}%0a%0a# A slightly different configuration for an internal subnet.%0a#subnet 10.5.5.0 netmask 255.255.255.224 {%0a#  range 10.5.5.26 10.5.5.30;%0a#  option domain-name-servers ns1.internal.example.org;%0a#  option domain-name "internal.example.org";%0a#  option routers 10.5.5.1;%0a#  option broadcast-address 10.5.5.31;%0a#  default-lease-time 600;%0a#  max-lease-time 7200;%0a#}%0a%0a# Hosts which require special configuration options can be listed in%0a# host statements.   If no address is specified, the address will be%0a# allocated dynamically (if possible), but the host-specific information%0a# will still come from the host declaration.%0a%0a#host passacaglia {%0a#  hardware ethernet 0:0:c0:5d:bd:95;%0a#  filename "vmunix.passacaglia";%0a#  server-name "toccata.fugue.com";%0a#}%0a%0a# Fixed IP addresses can also be specified for hosts.   These addresses%0a# should not also be listed as being available for dynamic assignment.%0a# Hosts for which fixed IP addresses have been specified can boot using%0a# BOOTP or DHCP.   Hosts for which no fixed address is specified can only%0a# be booted with DHCP, unless there is an address range on the subnet%0a# to which a BOOTP client is connected which has the dynamic-bootp flag%0a# set.%0a#host fantasia {%0a#  hardware ethernet 08:00:07:26:c0:a5;%0a#  fixed-address fantasia.fugue.com;%0a#}%0a%0a# You can declare a class of clients and then do address allocation%0a# based on that.   The example below shows a case where all clients%0a# in a certain class get addresses on the 10.17.224/24 subnet, and all%0a# other clients get addresses on the 10.0.29/24 subnet.%0a%0a#class "foo" {%0a#  match if substring (option vendor-class-identifier, 0, 4) = "SUNW";%0a#}%0a%0a#shared-network 224-29 {%0a#  subnet 10.17.224.0 netmask 255.255.255.0 {%0a#    option routers rtr-224.example.org;%0a#  }%0a#  subnet 10.0.29.0 netmask 255.255.255.0 {%0a#    option routers rtr-29.example.org;%0a#  }%0a#  pool {%0a#    allow members of "foo";%0a#    range 10.17.224.10 10.17.224.250;%0a#  }%0a#  pool {%0a#    deny members of "foo";%0a#    range 10.0.29.10 10.0.29.230;%0a#  }%0a#}@]
time=1195930237
author:1195930237=Avena
diff:1195930237:1195930237:=1,127d0%0a%3c [@#%0a%3c # Sample configuration file for ISC dhcpd for Debian%0a%3c #%0a%3c # $Id: dhcpd.conf,v 1.1.1.1 2002/05/21 00:07:44 peloy Exp $%0a%3c #%0a%3c %0a%3c # The ddns-updates-style parameter controls whether or not the server will%0a%3c # attempt to do a DNS update when a lease is confirmed. We default to the%0a%3c # behavior of the version 2 packages ('none', since DHCP v2 didn't%0a%3c # have support for DDNS.)%0a%3c ddns-update-style none;%0a%3c %0a%3c # option definitions common to all supported networks...%0a%3c option domain-name "example.org";%0a%3c option domain-name-servers ns1.example.org, ns2.example.org;%0a%3c %0a%3c default-lease-time 600;%0a%3c max-lease-time 7200;%0a%3c %0a%3c # If this DHCP server is the official DHCP server for the local%0a%3c # network, the authoritative directive should be uncommented.%0a%3c #authoritative;%0a%3c %0a%3c authoritative;%0a%3c %0a%3c subnet 192.168.20.0 netmask 255.255.255.0 {%0a%3c     range 192.168.20.20 192.168.20.250;%0a%3c     option domain-name "ltspcasa";%0a%3c     option domain-name-servers 192.168.20.1;%0a%3c     option broadcast-address 192.168.20.255;%0a%3c     option routers 192.168.20.1;%0a%3c     next-server 192.168.20.1;%0a%3c #    get-lease-hostnames true;%0a%3c     option subnet-mask 255.255.255.0;%0a%3c     option root-path "/opt/ltsp/i386";%0a%3c     if substring( option vendor-class-identifier, 0, 9 ) = "PXEClient" {%0a%3c         filename "/ltsp/i386/pxelinux.0";%0a%3c     } else {%0a%3c         filename "/ltsp/i386/nbi.img";%0a%3c     }%0a%3c }%0a%3c %0a%3c # Use this to send dhcp log messages to a different log file (you also%0a%3c # have to hack syslog.conf to complete the redirection).%0a%3c log-facility local7;%0a%3c %0a%3c # No service will be given on this subnet, but declaring it helps the %0a%3c # DHCP server to understand the network topology.%0a%3c %0a%3c #subnet 10.152.187.0 netmask 255.255.255.0 {%0a%3c #}%0a%3c %0a%3c # This is a very basic subnet declaration.%0a%3c %0a%3c #subnet 10.254.239.0 netmask 255.255.255.224 {%0a%3c #  range 10.254.239.10 10.254.239.20;%0a%3c #  option routers rtr-239-0-1.example.org, rtr-239-0-2.example.org;%0a%3c #}%0a%3c %0a%3c # This declaration allows BOOTP clients to get dynamic addresses,%0a%3c # which we don't really recommend.%0a%3c %0a%3c #subnet 10.254.239.32 netmask 255.255.255.224 {%0a%3c #  range dynamic-bootp 10.254.239.40 10.254.239.60;%0a%3c #  option broadcast-address 10.254.239.31;%0a%3c #  option routers rtr-239-32-1.example.org;%0a%3c #}%0a%3c %0a%3c # A slightly different configuration for an internal subnet.%0a%3c #subnet 10.5.5.0 netmask 255.255.255.224 {%0a%3c #  range 10.5.5.26 10.5.5.30;%0a%3c #  option domain-name-servers ns1.internal.example.org;%0a%3c #  option domain-name "internal.example.org";%0a%3c #  option routers 10.5.5.1;%0a%3c #  option broadcast-address 10.5.5.31;%0a%3c #  default-lease-time 600;%0a%3c #  max-lease-time 7200;%0a%3c #}%0a%3c %0a%3c # Hosts which require special configuration options can be listed in%0a%3c # host statements.   If no address is specified, the address will be%0a%3c # allocated dynamically (if possible), but the host-specific information%0a%3c # will still come from the host declaration.%0a%3c %0a%3c #host passacaglia {%0a%3c #  hardware ethernet 0:0:c0:5d:bd:95;%0a%3c #  filename "vmunix.passacaglia";%0a%3c #  server-name "toccata.fugue.com";%0a%3c #}%0a%3c %0a%3c # Fixed IP addresses can also be specified for hosts.   These addresses%0a%3c # should not also be listed as being available for dynamic assignment.%0a%3c # Hosts for which fixed IP addresses have been specified can boot using%0a%3c # BOOTP or DHCP.   Hosts for which no fixed address is specified can only%0a%3c # be booted with DHCP, unless there is an address range on the subnet%0a%3c # to which a BOOTP client is connected which has the dynamic-bootp flag%0a%3c # set.%0a%3c #host fantasia {%0a%3c #  hardware ethernet 08:00:07:26:c0:a5;%0a%3c #  fixed-address fantasia.fugue.com;%0a%3c #}%0a%3c %0a%3c # You can declare a class of clients and then do address allocation%0a%3c # based on that.   The example below shows a case where all clients%0a%3c # in a certain class get addresses on the 10.17.224/24 subnet, and all%0a%3c # other clients get addresses on the 10.0.29/24 subnet.%0a%3c %0a%3c #class "foo" {%0a%3c #  match if substring (option vendor-class-identifier, 0, 4) = "SUNW";%0a%3c #}%0a%3c %0a%3c #shared-network 224-29 {%0a%3c #  subnet 10.17.224.0 netmask 255.255.255.0 {%0a%3c #    option routers rtr-224.example.org;%0a%3c #  }%0a%3c #  subnet 10.0.29.0 netmask 255.255.255.0 {%0a%3c #    option routers rtr-29.example.org;%0a%3c #  }%0a%3c #  pool {%0a%3c #    allow members of "foo";%0a%3c #    range 10.17.224.10 10.17.224.250;%0a%3c #  }%0a%3c #  pool {%0a%3c #    deny members of "foo";%0a%3c #    range 10.0.29.10 10.0.29.230;%0a%3c #  }%0a%3c #}@]%0a\ No newline at end of file%0a
