m 60 nao%0a%3c [ws120.ltsp]%0a%3c        X_VERTREFRESH      = 55%0a%3c        X_MODE_0           = 1024x768%0a%3c %0a%3c @]%0a%3c %0a%3c %0a%3c '''/etc/dhcp3/dhcpd.conf'''%0a%3c [@%0a%3c # RealTek 8139A do 180mhz com 32mb ram (tinha 64mb....32mb foi um p100mhz)%0a%3c host ws105 {%0a%3c        hardware ethernet     00:E0:7D:80:25:39;%0a%3c        fixed-address         192.168.20.105;%0a%3c        filename              "/lts/vmlinuz-2.6.17.3-ltsp-1";%0a%3c }%0a%3c %0a%3c # Realtek 8029 pc100 usando VESA=800x600 16bits%0a%3c host ws110 {%0a%3c        hardware ethernet     00:E0:4C:DD:3B:0E;%0a%3c        fixed-address         192.168.20.110;%0a%3c        filename              "/lts/vmlinuz-2.6.17.3-ltsp-1";%0a%3c }%0a%3c %0a%3c # outro pc100 com video=trident - usa VESA fica 800x600%0a%3c host ws111 {%0a%3c        hardware ethernet     00:80:AD:41:84:31;%0a%3c        fixed-address         192.168.20.111;%0a%3c        filename              "/lts/vmlinuz-2.6.17.3-ltsp-1";%0a%3c }%0a%3c %0a%3c # pc100 com realtek8139 - com 16mb ficou em 800x600%0a%3c # memoria com paridade.%0a%3c host ws112 {%0a%3c        hardware ethernet     00:E0:7D:81:77:8D;%0a%3c        fixed-address         192.168.20.112;%0a%3c        filename              "/lts/vmlinuz-2.6.17.3-ltsp-1";%0a%3c }%0a%3c %0a%3c # sis onboard - tinha que compartilhar mais memoria no setup para placa de video=1024x768%0a%3c host ws120 {%0a%3c        hardware ethernet     00:02:44:36:53:D8;%0a%3c        fixed-address         192.168.20.120;%0a%3c        filename              "/lts/vmlinuz-2.6.17.3-ltsp-1";%0a%3c }%0a%3c %0a%3c # 486 de casa - maquina de teste :)%0a%3c host ws150 {%0a%3c        hardware ethernet     00:08:C7:4B:FC:CD;%0a%3c        fixed-address         192.168.20.150;%0a%3c        option option-128     e4:45:74:68:00:00;  # teclado ps/2%0a%3c        option option-129     "acpi=off";      #teclado ps/2..evita disparo de letras.%0a%3c        filename              "/lts/vmlinuz-2.6.17.3-ltsp-1";%0a%3c }%0a%3c