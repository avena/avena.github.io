text='''/etc/exports'''\\%0a[@%0a/opt/ltspnovo           *(ro,no_root_squash,async,no_subtree_check)%0a@]%0a%0a'''/etc/dhcp3/dhcpd.conf'''\\%0a[@%0a# dhcpd.conf%0a%0addns-update-style             ad-hoc;%0a%0aoption subnet-mask            255.255.255.0;%0aoption broadcast-address      192.168.20.255;%0aoption routers                192.168.20.1;%0aoption domain-name-servers    192.168.20.1;%0aoption domain-name            "ltsp";   # You really should fix this%0aoption option-128 code 128 = string;%0aoption option-129 code 129 = text;%0a#%0a#%0aget-lease-hostnames           true;%0a#%0anext-server                   192.168.20.1;%0aoption root-path              "/opt/ltspnovo/i386";%0a%0a#%0a#option root-path              "192.168.20.1:/opt/ltspnovo/i386";%0a#%0asubnet 192.168.20.0 netmask 255.255.255.0 {%0a    range 192.168.20.20 192.168.20.150;%0a    if substring( option vendor-class-identifier, 0, 9 ) = "PXEClient" {%0a        filename "/ltsp/i386/pxelinux.0";%0a    } else {%0a        filename "/ltsp/i386/nbi.img";%0a    }%0a}%0a@]%0a%0a'''/etc/ltsp/dhcpd.conf'''%0a[@%0a#%0a# Default LTSP dhcpd.conf config file.%0a#%0a%0aauthoritative;%0a%0asubnet 192.168.20.0 netmask 255.255.255.0 {%0a    range 192.168.20.20 192.168.20.150;%0a    option domain-name "ltsp";%0a    option domain-name-servers 192.168.20.1;%0a    option broadcast-address 192.168.20.255;%0a    option routers 192.168.20.1;%0a    next-server 192.168.20.1;%0a#    get-lease-hostnames true;%0a    option subnet-mask 255.255.255.0;%0a    option root-path "/opt/ltspnovo/i386";%0a    if substring( option vendor-class-identifier, 0, 9 ) = "PXEClient" {%0a        filename "/ltspnovo/i386/pxelinux.0";%0a    } else {%0a        filename "/ltspnovo/i386/nbi.img";%0a    }%0a}%0a@]%0a%0a%0a'''Arquivo .tar.gz do ambiente chroot do LTSP5'''
