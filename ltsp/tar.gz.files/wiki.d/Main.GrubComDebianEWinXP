text=[@# menu.lst - See: grub(8), info grub, update-grub(8)%0a#            grub-install(8), grub-floppy(8),%0a#            grub-md5-crypt, /usr/share/doc/grub%0a#            and /usr/share/doc/grub-doc/.%0a%0a## default num%0a# Set the default entry to the entry number NUM. Numbering starts from 0, and%0a# the entry number 0 is the default if the command is not used.%0a#%0a# You can specify 'saved' instead of a number. In this case, the default entry%0a# is the entry saved with the command 'savedefault'.%0a# WARNING: If you are using dmraid do not change this entry to 'saved' or your%0a# array will desync and will not let you boot your system.%0adefault         1%0a%0a## timeout sec%0a# Set a timeout, in SEC seconds, before automatically booting the default entry%0a# (normally the first entry defined).%0atimeout         120%0a%0a# Pretty colours%0acolor cyan/blue white/blue%0a%0a## password ['--md5'] passwd%0a# If used in the first section of a menu file, disable all interactive editing%0a# control (menu entry editor and command-line)  and entries protected by the%0a# command 'lock'%0a# e.g. password topsecret%0a#      password --md5 $1$gLhU0/$aW78kHK1QfV3P2b2znUoe/%0a# password topsecret%0a%0a#%0a# examples%0a#%0a# title         Windows 95/98/NT/2000%0a# root          (hd0,0)%0a# makeactive%0a# chainloader   +1%0a#%0a# title         Linux%0a# root          (hd0,1)%0a# kernel        /vmlinuz root=/dev/hda2 ro%0a#%0a%0a#%0a# Put static boot stanzas before and/or after AUTOMAGIC KERNEL LIST%0a%0a### BEGIN AUTOMAGIC KERNELS LIST%0a## lines between the AUTOMAGIC KERNELS LIST markers will be modified%0a## by the debian update-grub script except for the default options below%0a%0a## DO NOT UNCOMMENT THEM, Just edit them to your needs%0a%0a## ## Start Default Options ##%0a## default kernel options%0a## default kernel options for automagic boot options%0a## If you want special options for specific kernels use kopt_x_y_z%0a## where x.y.z is kernel version. Minor versions can be omitted.%0a## e.g. kopt=root=/dev/hda1 ro%0a##      kopt_2_6_8=root=/dev/hdc1 ro%0a##      kopt_2_6_8_2_686=root=/dev/hdc2 ro%0a# kopt=root=/dev/hdb1 ro%0a%0a## default grub root device%0a## e.g. groot=(hd0,0)%0a# groot=(hd1,0)%0a%0a## should update-grub create alternative automagic boot options%0a## e.g. alternative=true%0a##      alternative=false%0a# alternative=true%0a%0a## should update-grub lock alternative automagic boot options%0a## e.g. lockalternative=true%0a##      lockalternative=false%0a# lockalternative=false%0a%0a## additional options to use with the default boot option, but not with the%0a## alternatives%0a## e.g. defoptions=vga=791 resume=/dev/hda5%0a# defoptions=%0a%0a## should update-grub lock old automagic boot options%0a## e.g. lockold=false%0a##      lockold=true%0a# lockold=false%0a%0a## Xen hypervisor options to use with the default Xen boot option%0a# xenhopt=%0a%0a## Xen Linux kernel options to use with the default Xen boot option%0a# xenkopt=console=tty0%0a%0a## altoption boot targets option%0a## multiple altoptions lines are allowed%0a## e.g. altoptions=(extra menu suffix) extra boot options%0a##      altoptions=(single-user) single%0a# altoptions=(single-user mode) single%0a%0a## controls how many kernels should be put into the menu.lst%0a## only counts the first occurence of a kernel, not the%0a## alternative kernel options%0a## e.g. howmany=all%0a##      howmany=7%0a# howmany=all%0a%0a## should update-grub create memtest86 boot option%0a## e.g. memtest86=true%0a##      memtest86=false%0a# memtest86=true%0a%0a## should update-grub adjust the value of the default booted system%0a## can be true or false%0a# updatedefaultentry=false%0a%0a## ## End Default Options ##%0a%0atitle           Debian GNU/Linux, kernel 2.6.18-5-686%0aroot            (hd1,0)%0akernel          /boot/vmlinuz-2.6.18-5-686 root=/dev/hdb1 ro%0ainitrd          /boot/initrd.img-2.6.18-5-686%0asavedefault%0a%0a#title          Debian GNU/Linux, kernel 2.6.18-5-686 (single-user mode)%0a#root           (hd1,0)%0a#kernel         /boot/vmlinuz-2.6.18-5-686 root=/dev/hdb1 ro single%0a#initrd         /boot/initrd.img-2.6.18-5-686%0a#savedefault%0a%0a### END DEBIAN AUTOMAGIC KERNELS LIST%0a%0a# This is a divider, added to separate the menu items below from the Debian%0a# ones.%0a#title          Other operating systems:%0a#root%0a%0a%0a# This entry automatically added by the Debian installer for a non-linux OS%0a# on /dev/hda1%0atitle           Microsoft Windows XP Professional%0aroot            (hd0,0)%0asavedefault%0amakeactive%0achainloader     +1@]
