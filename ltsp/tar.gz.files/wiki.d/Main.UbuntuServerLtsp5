h DHCP, unless there is an address range on the subnet%0a%3c # to which a BOOTP client is connected which has the dynamic-bootp flag%0a%3c # set.%0a%3c #host fantasia {%0a%3c #  hardware ethernet 08:00:07:26:c0:a5;%0a%3c #  fixed-address fantasia.fugue.com;%0a%3c #}%0a%3c %0a%3c # You can declare a class of clients and then do address allocation%0a%3c # based on that.   The example below shows a case where all clients%0a%3c # in a certain class get addresses on the 10.17.224/24 subnet, and all%0a%3c # other clients get addresses on the 10.0.29/24 subnet.%0a%3c %0a%3c #class "foo" {%0a%3c #  match if substring (option vendor-class-identifier, 0, 4) = "SUNW";%0a%3c #}%0a%3c %0a%3c #shared-network 224-29 {%0a%3c #  subnet 10.17.224.0 netmask 255.255.255.0 {%0a%3c #    option routers rtr-224.example.org;%0a%3c #  }%0a%3c #  subnet 10.0.29.0 netmask 255.255.255.0 {%0a%3c #    option routers rtr-29.example.org;%0a%3c #  }%0a%3c #  pool {%0a%3c #    allow members of "foo";%0a%3c #    range 10.17.224.10 10.17.224.250;%0a%3c #  }%0a%3c #  pool {%0a%3c #    deny members of "foo";%0a%3c #    range 10.0.29.10 10.0.29.230;%0a%3c #  }%0a%3c #}@]%0a%3c %0a%3c %0a%3c %0a%3c %0a%3c cat /etc/inetd.conf%0a%3c [@# /etc/inetd.conf:  see inetd(8) for further informations.%0a%3c #%0a%3c # Internet superserver configuration database%0a%3c #%0a%3c #%0a%3c # Lines starting with "#:LABEL:" or "#%3coff>#" should not%0a%3c # be changed unless you know what you are doing!%0a%3c #%0a%3c # If you want to disable an entry so it isn't touched during%0a%3c # package updates just comment it out with a single '#' character.%0a%3c #%0a%3c # Packages should modify this file by using update-inetd(8)%0a%3c #%0a%3c # %3cservice_name> %3csock_type> %3cproto> %3cflags> %3cuser> %3cserver_path> %3cargs>%0a%3c #%0a%3c #:INTERNAL: Internal services%0a%3c #discard                stream  tcp     nowait  root    internal%0a%3c #discard                dgram   udp     wait    root    internal%0a%3c #daytime          