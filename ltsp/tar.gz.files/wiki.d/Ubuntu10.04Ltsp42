diff:1297811403:1296854148:=9c9%0a%3c http://idsorocaba.batemacumba.net/ltsp/utils/\\%0a---%0a> http://idsorocaba.ourproject.org/ltsp/utils/\\%0a29,30c29,30%0a%3c http://idsorocaba.batemacumba.net/ltsp/isos/%0a%3c %0a---%0a> http://idsorocaba.ourproject.org/ltsp/isos/%0a> %0a36c36%0a%3c http://idsorocaba.batemacumba.net/imagens_debian_lenny/ltspadmin_conf_install.png%0a---%0a> http://idsorocaba.ourproject.org/imagens_debian_lenny/ltspadmin_conf_install.png%0a45,47c45,47%0a%3c http://idsorocaba.batemacumba.net/imagens_debian_lenny/ltspadmin_conf_install-feito.png%0a%3c %0a%3c %0a---%0a> http://idsorocaba.ourproject.org/imagens_debian_lenny/ltspadmin_conf_install-feito.png%0a> %0a> %0a50c50%0a%3c http://idsorocaba.batemacumba.net/imagens_debian_lenny/ltspadmin_conf_install-selecionar.png\\%0a---%0a> http://idsorocaba.ourproject.org/imagens_debian_lenny/ltspadmin_conf_install-selecionar.png\\%0a91,92c91,92%0a%3c http://idsorocaba.batemacumba.net/imagens_debian_lenny/ltspcfg_programas_instalados.png%0a%3c %0a---%0a> http://idsorocaba.ourproject.org/imagens_debian_lenny/ltspcfg_programas_instalados.png%0a> %0a105,106c105,106%0a%3c http://idsorocaba.batemacumba.net/imagens_debian_lenny/ltspcfg-c.png%0a%3c %0a---%0a> http://idsorocaba.ourproject.org/imagens_debian_lenny/ltspcfg-c.png%0a> %0a405,406c405,406%0a%3c Configuração baseada na: [[Main.InstalacaoLtspDebianEtch|Instalação LTSP4.2 no Debian Etch]]\\%0a%3c %0a---%0a> Configuração baseada na: [[http://idsorocaba.ourproject.org/index.php?n=Main.InstalacaoLtspDebianEtch|Instalação LTSP4.2 no Debian Etch]]\\%0a> %0a
